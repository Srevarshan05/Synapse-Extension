{
  "manifest_version": 3,
  "name": "Synapse v3",
  "version": "3.0.0",
  "description": "Universal LLM context continuity engine. Capture conversations, compress context, and continue seamlessly across 12 AI platforms.",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "optional_permissions": [
    "activeTab"
  ],

  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://kimi.moonshot.cn/*",
    "https://grok.com/*",
    "https://copilot.microsoft.com/*",
    "https://www.perplexity.ai/*",
    "https://poe.com/*",
    "https://openrouter.ai/*",
    "https://chat.mistral.ai/*",
    "https://chat.qwen.ai/*"
  ],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://kimi.moonshot.cn/*",
    "https://grok.com/*",
    "https://copilot.microsoft.com/*",
    "https://www.perplexity.ai/*",
    "https://poe.com/*",
    "https://openrouter.ai/*",
    "https://chat.mistral.ai/*",
    "https://chat.qwen.ai/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*",
    "https://*.anthropic.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.ggpht.com/*",
    "https://*.githubusercontent.com/*",
    "http://127.0.0.1:3742/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Synapse v3"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://kimi.moonshot.cn/*",
        "https://grok.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*",
        "https://openrouter.ai/*",
        "https://chat.mistral.ai/*",
        "https://chat.qwen.ai/*"
      ],
      "js": ["content.bundle.js"],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html",
        "workers/compression.worker.js",
        "workers/pdf.worker.js",
        "workers/ocr.worker.js",
        "workers/attachment.worker.js",
        "dashboard/index.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
